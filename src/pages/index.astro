  </main>

  <!-- Ft5 Statement Footer -->
  <footer class="footer-statement">
    <div class="container">
      <h2 class="footer-display">
        where truth meets illusion<span
          id="secretTrigger"
          style="cursor: pointer; color: var(--color-accent);">.</span
        >
      </h2>
      <div class="footer-meta">
        <div class="footer-wordmark">NRVA</div>
        <div class="footer-links">
          <span>© 2026. All rights reserved.</span>
          <span>Made by VDTYA</span>
        </div>
      </div>
    </div>
  </footer>

  <div id="secretTerminal">
    <div
      class="terminal-content"
      id="terminalBox"
      onclick="document.getElementById('terminalInput')?.focus()"
    >
      <div id="terminalHistory"></div>
      <div class="terminal-input-line">
        <span class="term-muted">nrva@sundering:~$</span>
        <input
          type="text"
          id="terminalInput"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
    </div>
    <p class="close-hint">[ PRESS ESC TO CLOSE ]</p>
  </div>
  <div id="realityToast" class="reality-toast"></div>
</Layout>

<script>
  // Simple intersection observer for reveal-on-scroll elements
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
  );

  document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
    observer.observe(el);
  });

  /* ── SECRET TERMINAL SYSTEM ── */
  const secretTrigger = document.getElementById("secretTrigger");
  const secretTerminal = document.getElementById("secretTerminal");
  const terminalHistory = document.getElementById("terminalHistory");
  const terminalInput = document.getElementById("terminalInput");

  function openTerminal() {
    if (secretTerminal) secretTerminal.style.display = "block";
    document.body.style.overflow = "hidden";
    setTimeout(() => terminalInput?.focus(), 100);
  }
  function closeTerminal() {
    if (secretTerminal) secretTerminal.style.display = "none";
    document.body.style.overflow = "";
  }

  if (secretTrigger) {
    secretTrigger.addEventListener("click", openTerminal);
  }

  if (secretTerminal) {
    secretTerminal.addEventListener("click", (e) => {
      if (e.target === secretTerminal) closeTerminal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && secretTerminal.style.display === "block")
        closeTerminal();
    });

    function printLine(text, isCmd = false) {
      const line = document.createElement("div");
      line.className = "term-line";
      line.innerHTML = isCmd
        ? `<span class="term-muted">nrva@sundering:~$</span> ${text}`
        : text;
      terminalHistory.appendChild(line);
      terminalHistory.scrollTop = terminalHistory.scrollHeight;
    }

    if (terminalInput) {
      terminalInput.addEventListener("keypress", function (e) {
        if (e.key === "Enter") {
          const cmd = this.value.trim();
          this.value = "";
          if (cmd) {
            printLine(cmd, true);
            processCommand(cmd);
          }
        }
      });
    }

    function processCommand(cmd) {
      const args = cmd.toLowerCase().split(" ");
      switch (args[0]) {
        case "help":
          printLine("AVAILABLE PROTOCOLS:");
          printLine(
            "- <span class='term-highlight'>DECRYPT [file_id]</span> : Decode fractured memory.",
          );
          printLine(
            "- <span class='term-highlight'>CLEAR</span>             : Wipe terminal memory.",
          );
          printLine(
            "- <span class='term-highlight'>EXIT</span>              : Close session.",
          );
          break;
        case "decrypt":
          if (args[1] === "frag_001") {
            printLine("> DECRYPTING FRAG_001...");
            terminalInput.disabled = true;
            setTimeout(() => {
              printLine(
                "<span class='term-highlight'>[ SUCCESS ]</span> DATA RECOVERED.",
              );
              printLine(
                "<i>we've no idea what we've got until we lose it all... Until I Lose You.</i>",
              );
              terminalInput.disabled = false;
              terminalInput.focus();
            }, 1200);
          } else if (args[1] === "frag_002") {
            printLine("> DECRYPTING FRAG_002...");
            terminalInput.disabled = true;
            setTimeout(() => {
              printLine(
                "<span class='term-highlight'>[ SUCCESS ]</span> DATA RECOVERED.",
              );
              printLine(
                "<i>and what's left behind is nothing more than... a Sweet Synthetic Memory.</i>",
              );
              terminalInput.disabled = false;
              terminalInput.focus();
            }, 1200);
          } else if (args[1] === "ssm_002") {
            printLine("> VERIFYING OVERRIDE CODE...");
            terminalInput.disabled = true;
            setTimeout(() => {
              printLine(
                "<span class='term-highlight'>[ SUCCESS ]</span> CLEARANCE ACCEPTED.",
              );
              setTimeout(() => (window.location.href = "vault.html"), 1000);
            }, 1200);
          } else if (args[1] === "ssm_005") {
            printLine("> VERIFYING OVERRIDE CODE...");
            terminalInput.disabled = true;
            setTimeout(() => {
              printLine(
                "<span class='term-highlight'>[ SUCCESS ]</span> CLEARANCE ACCEPTED.",
              );
              setTimeout(() => (window.location.href = "vault2.html"), 1000);
            }, 1200);
          } else if (args[1] === "uily_001") {
            printLine("> VERIFYING OVERRIDE CODE...");
            terminalInput.disabled = true;
            setTimeout(() => {
              printLine(
                "<span class='term-highlight'>[ SUCCESS ]</span> CLEARANCE ACCEPTED.",
              );
              setTimeout(() => (window.location.href = "vault3.html"), 1000);
            }, 1200);
          } else if (args[1]) {
            printLine(`> ERROR: ${args[1].toUpperCase()} NOT FOUND.`);
          } else {
            printLine("> ERROR: Missing file ID. Usage: DECRYPT [file_id]");
          }
          break;
        case "clear":
          terminalHistory.innerHTML = "";
          break;
        case "exit":
          closeTerminal();
          break;
        default:
          printLine(
            `> Command not recognized: ${args[0]}. Type HELP to view protocols.`,
          );
      }
    }

    printLine("Secure Terminal v1.0.0");
    printLine("Type <span class='term-highlight'>HELP</span> to begin.");
    printLine("");
  }
</script>

<style>
  /* N5 Floating Pill Nav */
  .nav-pill {
    position: fixed;
    top: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    width: min(90%, 640px);
    height: 56px;
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-xs) 0 var(--space-lg);
    z-index: 100;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .nav-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .nav-links a {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: 500;
    transition: color var(--dur-short, 0.2s) var(--ease-out, ease);
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-cta {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: all var(--dur-short, 0.2s) var(--ease-out, ease);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
    color: var(--color-accent-ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-toggle-checkbox,
  .nav-toggle-label {
    display: none;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: flex;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity var(--dur-medium, 0.3s) var(--ease-out, ease),
                  transform var(--dur-medium, 0.3s) var(--ease-out, ease),
                  visibility var(--dur-medium, 0.3s) var(--ease-out, ease);
      position: absolute;
      top: calc(100% + var(--space-xs));
      left: 0;
      width: 100%;
      background: color-mix(in srgb, var(--color-paper) 85%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: var(--radius-lg);
      padding: var(--space-md);
      flex-direction: column;
      gap: var(--space-md);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .nav-toggle-checkbox:checked ~ .nav-links {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-toggle-checkbox:checked ~ .nav-actions .nav-toggle-label {
      color: var(--color-accent);
    }

    .nav-pill {
      padding: 0 var(--space-md);
    }

    .nav-toggle-label {
      display: block;
      cursor: pointer;
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-ink);
      user-select: none;
      padding: var(--space-2xs) 0;
      transition: color var(--dur-short, 0.2s) var(--ease-out, ease);
    }
  }

  /* 03 Marquee Hero */
  .marquee-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: var(--space-4xl) clamp(1rem, 4vw, 2rem) 0;
  }

  .marquee-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-wordmark-svg {
    max-width: 400px;
    width: 100%;
    height: auto;
  }

  .marquee-display {
    font-size: var(--text-hero);
    line-height: 1.05;
    color: var(--color-ink);
    max-width: 1400px;
    margin: 0;
  }

  .rule-thick {
    border: none;
    height: 4px;
    background-color: var(--color-rule);
    margin: 0;
    width: 100%;
  }

  /* Shared Typography & Spacing */
  .section-pad {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
  }

  .margin-top-lg {
    margin-top: var(--space-xl);
  }

  .mono-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Split Layout */
  .split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .split-info .eyebrow {
    margin-bottom: var(--space-xs);
  }

  .section-heading {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-md);
  }

  .section-desc {
    font-size: var(--text-lg);
    margin-bottom: var(--space-xl);
    max-width: 40ch;
  }

  .btn-primary {
    display: inline-flex;
    background: var(--color-paper-2);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-pill);
    font-weight: 500;
  }

  .btn-primary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .spotify-wrapper {
    background: var(--color-paper-2);
    border-radius: var(--radius-card);
    overflow: hidden;
    padding: var(--space-xs);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 960px) {
    .split-layout {
      grid-template-columns: 1fr;
    }
    .section-heading {
      font-size: var(--text-2xl);
    }
  }

  /* About Layout */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-2xl);
  }

  .text-large {
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-ink);
    margin-bottom: var(--space-xl);
  }

  .text-contact {
    font-size: var(--text-md);
  }

  .text-link {
    display: inline-block;
    margin-top: var(--space-xs);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
  }

  .text-link:hover {
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .text-large {
      font-size: var(--text-lg);
    }
  }

  /* Releases Table */
  .releases-header {
    margin-bottom: var(--space-lg);
  }

  .rule-hairline {
    height: 1px;
    background: var(--color-rule);
    margin-top: var(--space-sm);
  }

  .tabular-row {
    display: grid;
