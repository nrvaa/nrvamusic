---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <!-- Vault Nav -->
  <nav class="nav-pill" aria-label="Primary" style="justify-content: space-between; position: fixed; top: var(--space-md); left: 50%; transform: translateX(-50%); width: calc(100% - var(--space-md)*2); max-width: 1200px;">
    <a href="/" class="nav-cta" style="margin:0; text-decoration: none;"><i class="fas fa-arrow-left"></i> &nbsp; EXIT VAULT</a>
    <div class="nav-wordmark">SECURE TERMINAL</div>
  </nav>

  <div class="vault-wrapper">
    <div class="vault-header">
      <span class="vault-eyebrow">CLASSIFIED AUDIO // SECURE VAULT ACCESSED</span>
      <h1 class="vault-title">All Our Colours — Preview</h1>
      <p class="vault-sub">NRVA — UNRELEASED SCRIPTURE</p>
    </div>

    <div class="player-card" id="playerCard">
      <div class="track-status" id="trackStatus">STANDBY</div>
      <div class="track-title" id="trackTitle">All Our Colours — Preview</div>
      <p class="track-artist">NRVA — Unreleased</p>

      <div class="controls-container">
        <div class="btn-group">
          <button class="ctrl-btn" id="restartBtn" aria-label="Restart">
            <i class="fas fa-backward-step"></i>
          </button>
          <button class="ctrl-btn play-btn" id="playBtn" aria-label="Play">
            <i class="fas fa-play" id="playIcon"></i>
          </button>
        </div>
        <div class="progress-wrapper">
          <span class="time-display" id="currentTime">0:00</span>
          <div class="progress-track" id="progressTrack">
            <div class="progress-fill" id="progressFill"></div>
            <input type="range" class="seek-bar" id="progressBar" value="0" max="100" step="0.1" />
          </div>
          <span class="time-display" id="duration">0:00</span>
        </div>
      </div>

      <div class="waveform-wrap" id="waveformWrap">
        <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
        <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
        <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
        <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
      </div>
      <audio id="audioData" src="/SSM_002.wav" preload="metadata"></audio>
    </div>

    <div class="vault-terminal" onclick="document.getElementById('vaultTermInput')?.focus()">
      <div class="term-header">NRVA VAULT TERMINAL v1.0 // TYPE 'HELP' FOR PROTOCOLS</div>
      <div class="term-history" id="termHistory">
        <div class="term-line"><span class="term-muted">nrva@vault:~$</span> <span class="term-highlight">SECURE VAULT ACCESSED.</span></div>
        <div class="term-line"><span class="term-muted">nrva@vault:~$</span> AUDIO SUBSYSTEM ONLINE.</div>
      </div>
      <div class="term-input-row">
        <span class="term-prompt">nrva@vault:~$</span>
        <input type="text" id="vaultTermInput" autocomplete="off" spellcheck="false" autofocus />
      </div>
    </div>
  </div>
</Layout>

<script>
  /* ── AUDIO PLAYER ── */
  const audio = document.getElementById("audioData") as HTMLAudioElement;
  const playBtn = document.getElementById("playBtn");
  const playIcon = document.getElementById("playIcon");
  const progressBar = document.getElementById("progressBar") as HTMLInputElement;
  const progressFill = document.getElementById("progressFill");
  const currentTimeEl = document.getElementById("currentTime");
  const durationEl = document.getElementById("duration");
  const trackStatus = document.getElementById("trackStatus");
  const waveWrap = document.getElementById("waveformWrap");
  let isPlaying = false;

  function formatTime(s) {
    if (isNaN(s)) return "0:00";
    let m = Math.floor(s / 60), sec = Math.floor(s % 60);
    return `${m}:${sec < 10 ? "0" + sec : sec}`;
  }

  function setPlaying(play) {
    isPlaying = play;
    if (play) {
      if (playIcon) playIcon.className = "fas fa-pause";
      if (trackStatus) trackStatus.textContent = "PLAYING";
      if (waveWrap) waveWrap.classList.add("playing");
    } else {
      if (playIcon) playIcon.className = "fas fa-play";
      if (trackStatus) trackStatus.textContent = "PAUSED";
      if (waveWrap) waveWrap.classList.remove("playing");
    }
  }

  if (audio) {
    audio.addEventListener("loadedmetadata", () => {
      if (progressBar) progressBar.max = audio.duration.toString();
      if (durationEl) durationEl.textContent = formatTime(audio.duration);
    });
    
    if (audio.readyState >= 1 && durationEl) {
      durationEl.textContent = formatTime(audio.duration);
      if (progressBar) progressBar.max = audio.duration.toString();
    }

    if (playBtn) {
      playBtn.addEventListener("click", () => {
        if (isPlaying) { audio.pause(); setPlaying(false); } 
        else { audio.play(); setPlaying(true); }
      });
    }

    const restartBtn = document.getElementById("restartBtn");
    if (restartBtn) {
      restartBtn.addEventListener("click", () => {
        audio.currentTime = 0;
        if (!isPlaying) { audio.play(); setPlaying(true); }
      });
    }

    audio.addEventListener("timeupdate", () => {
      const p = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      if (progressFill) progressFill.style.width = p + "%";
      if (progressBar) progressBar.value = audio.currentTime.toString();
      if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
    });

    if (progressBar) {
      progressBar.addEventListener("input", () => {
        audio.currentTime = parseFloat(progressBar.value);
      });
    }

    audio.addEventListener("ended", () => {
      setPlaying(false);
      if (progressFill) progressFill.style.width = "0%";
      if (currentTimeEl) currentTimeEl.textContent = "0:00";
      if (trackStatus) trackStatus.textContent = "COMPLETED";
    });
  }

  /* ── VAULT TERMINAL ── */
  const termInput = document.getElementById("vaultTermInput") as HTMLInputElement;
  const termHistory = document.getElementById("termHistory");

  function printLine(text, isCmd = false) {
    if (!termHistory) return;
    const line = document.createElement("div");
    line.className = "term-line";
    line.innerHTML = isCmd ? `<span class="term-muted">nrva@vault:~$</span> ${text}` : `> ${text}`;
    termHistory.appendChild(line);
    termHistory.scrollTop = termHistory.scrollHeight;
  }

  if (termInput) {
    termInput.addEventListener("keypress", function (e) {
      if (e.key === "Enter") {
        const cmd = this.value.trim().toLowerCase();
        const args = cmd.split(" ");
        this.value = "";
        if (!cmd) return;
        
        const line = document.createElement("div");
        line.className = "term-line";
        line.innerHTML = `<span class="term-muted">nrva@vault:~$</span> ${cmd}`;
        termHistory.appendChild(line);
        termHistory.scrollTop = termHistory.scrollHeight;

        if (args[0] === "exit" || args[0] === "return") {
          printLine("DISCONNECTING... RETURNING TO SURFACE.");
          termInput.disabled = true;
          setTimeout(() => (window.location.href = "/"), 1000);
        } else if (args[0] === "help") {
          printLine("<span class='term-highlight'>EXIT</span> — Leave vault.");
          printLine("<span class='term-highlight'>PLAY / PAUSE</span> — Control audio sequence.");
          printLine("<span class='term-highlight'>RESTART</span> — Restart from beginning.");
          printLine("<span class='term-highlight'>CLEAR</span> — Wipe terminal memory.");
        } else if (args[0] === "play") {
          if (audio) { audio.play(); setPlaying(true); printLine("PLAYING AUDIO SEQUENCE."); }
        } else if (args[0] === "pause") {
          if (audio) { audio.pause(); setPlaying(false); printLine("AUDIO SEQUENCE PAUSED."); }
        } else if (args[0] === "restart") {
          if (audio) { audio.currentTime = 0; audio.play(); setPlaying(true); printLine("RESTARTING SEQUENCE."); }
        } else if (args[0] === "clear") {
          termHistory.innerHTML = "";
        } else {
          printLine(`ERROR: '${args[0]}' not recognized. Type HELP for protocols.`);
        }
      }
    });
  }
</script>

<style>
  .vault-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    padding: 120px var(--space-md) 60px;
    z-index: 10;
    opacity: 0;
    animation: vaultIn 1s ease 0.3s forwards;
  }
  @keyframes vaultIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: none; }
  }

  .vault-header {
    margin-bottom: var(--space-xl);
    text-align: center;
    width: 100%;
  }
  .vault-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.5em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
    display: block;
    animation: breathe 3s ease infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .vault-title {
    font-size: var(--text-2xl);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: var(--space-3xs);
  }
  .vault-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--color-muted);
  }

  .player-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    padding: var(--space-xl);
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-md);
    width: 100%;
    backdrop-filter: blur(16px);
    transition: border-color 0.35s, box-shadow 0.35s;
  }
  .player-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.5;
  }
  .player-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }

  .track-status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.45em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .track-status::before {
    content: "";
    width: 6px; height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: pulse-dot 1.5s ease infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.5); opacity: 0.4; }
  }

  .track-title {
    font-size: var(--text-xl);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: var(--space-3xs);
    line-height: 1.2;
  }
  .track-artist {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
  }

  .controls-container {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .btn-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ctrl-btn {
    width: 42px; height: 42px;
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .ctrl-btn:hover {
    border-color: rgba(255,255,255,0.2);
    color: var(--color-ink);
    transform: scale(1.06);
  }
  .play-btn {
    width: 52px; height: 52px;
    border: 1px solid var(--color-muted);
    color: var(--color-ink);
    font-size: 1.1rem;
    position: relative;
    overflow: hidden;
  }
  .play-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent);
    transform: scale(0);
    transition: transform 0.35s ease;
    opacity: 0.15;
  }
  .play-btn:hover::before { transform: scale(1); }
  .play-btn:hover {
    box-shadow: 0 0 24px rgba(255,0,64,0.2);
    border-color: var(--color-accent);
  }

  .progress-wrapper {
    flex-grow: 1;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .time-display {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    white-space: nowrap;
    min-width: 32px;
    text-align: center;
  }
  .progress-track {
    flex: 1;
    height: 2px;
    background: var(--color-rule);
    position: relative;
    cursor: pointer;
  }
  .progress-fill {
    height: 100%;
    background: var(--color-ink);
    width: 0%;
    transition: width 0.1s linear;
    position: relative;
  }
  .progress-fill::after {
    content: "";
    position: absolute;
    right: -5px; top: 50%;
    transform: translateY(-50%);
    width: 10px; height: 10px;
    background: var(--color-ink);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .progress-track:hover .progress-fill::after { opacity: 1; }

  input[type="range"].seek-bar {
    position: absolute;
    inset: -6px 0;
    width: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .waveform-wrap {
    margin: 24px 0 0;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    overflow: hidden;
  }
  .wave-bar {
    width: 3px;
    border-radius: 2px;
    background: var(--color-muted);
    opacity: 0.3;
    transform-origin: center;
    transition: background 0.3s, opacity 0.3s;
  }
  .playing .wave-bar {
    opacity: 0.6;
    background: var(--color-ink);
    animation: waveAnim 0.8s ease infinite alternate;
  }
  .playing .wave-bar:nth-child(even) { animation-duration: 0.5s; }
  .playing .wave-bar:nth-child(3n) { animation-duration: 1.1s; }
  
  @keyframes waveAnim {
    from { transform: scaleY(0.2); }
    to   { transform: scaleY(1); }
  }

  .vault-terminal {
    background: rgba(0,0,0,0.5);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    cursor: text;
    display: flex;
    flex-direction: column;
    width: 100%;
    transition: border-color 0.35s;
    backdrop-filter: blur(8px);
  }
  .vault-terminal:hover { border-color: rgba(255,255,255,0.1); }
  .vault-terminal:focus-within { border-color: var(--color-accent); }

  .term-header {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.35em;
    color: var(--color-muted);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-rule);
  }
  .term-history {
    max-height: 160px;
    overflow-y: auto;
    margin-bottom: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .term-history::-webkit-scrollbar { width: 2px; }
  .term-history::-webkit-scrollbar-thumb { background: var(--color-rule); }

  .term-line { margin-bottom: 3px; color: var(--color-ink); }
  .term-highlight { color: var(--color-accent); font-weight: 500; }
  .term-muted { color: var(--color-muted); font-family: var(--font-mono); }
  
  .term-input-row {
    display: flex;
    align-items: center;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--color-rule);
    flex-shrink: 0;
  }
  .term-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-right: 10px;
    white-space: nowrap;
  }
  #vaultTermInput {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    flex-grow: 1;
    caret-color: var(--color-accent);
  }
</style>
